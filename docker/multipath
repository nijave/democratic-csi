#!/usr/bin/env bash

P="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/run/current-system/sw/bin"

# exec so multipath runs in the pid the caller tracks; without it a killed
# wrapper orphans multipath to PID 1 (node reaps only what it spawns) -> zombie.
for p in $(echo $P | cut -d ":" -f 1- --output-delimiter=" "); do
  if [[ -f "/host${p}/multipath" ]]; then
    exec chroot /host "${p}/multipath" "${@:1}"
  fi
done

exec chroot /host /usr/bin/env -i PATH="${P}" multipath "${@:1}"
